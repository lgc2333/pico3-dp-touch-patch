{
  "private": true,
  "scripts": {
    "check": "pnpm run check:shell && pnpm run check:ps && pnpm run check:js && pnpm run check:md",
    "check:shell": "uvx --from shellcheck-py shellcheck -s sh src/termux/dptouch.sh src/termux/install.sh src/shared/start_touch.sh src/magisk/customize.sh",
    "check:ps": "powershell -NoProfile -File scripts/format_ps.ps1 -Check && powershell -NoProfile -File scripts/lint_ps.ps1",
    "check:js": "node --check src/shared/hook.js",
    "check:md": "pnpx prettier -c AGENTS.md README.md README.en.md \"docs/notes/**/*.md\" \".github/workflows/*.yml\"",
    "fmt:ps": "powershell -NoProfile -File scripts/format_ps.ps1",
    "fmt:md": "pnpx prettier -w AGENTS.md README.md README.en.md \"docs/notes/**/*.md\" \".github/workflows/*.yml\"",
    "build:magisk": "powershell -NoProfile -ExecutionPolicy Bypass -File src/magisk/tools/build_module.ps1",
    "deps": "powershell -ExecutionPolicy Bypass -File src/windows/src/get_deps.ps1",
    "device:id": "powershell -NoProfile -File scripts/device_probe.ps1 -What id",
    "device:seccomp": "powershell -NoProfile -File scripts/device_probe.ps1 -What seccomp",
    "device:hook": "powershell -NoProfile -File scripts/device_probe.ps1 -What hook",
    "device:kit": "powershell -NoProfile -File scripts/device_probe.ps1 -What kit",
    "device:logs": "powershell -NoProfile -File scripts/device_probe.ps1 -What logs",
    "device:all": "powershell -NoProfile -File scripts/device_probe.ps1 -What all"
  }
}
