root = true

# PowerShell：含中文的 .ps1 必须是 UTF-8 BOM，否则 Windows PowerShell 5.1 按 GBK 读会乱码
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{sh,js,json}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.{md}]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = false
